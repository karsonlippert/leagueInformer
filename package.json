{
  "name": "league-informer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --no-warnings --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "import-data": "node --experimental-strip-types --no-warnings scripts/import-data.ts",
    "data:check": "node --experimental-strip-types --no-warnings scripts/validate-data.ts",
    "import-tiers": "node --experimental-strip-types --no-warnings scripts/import-tiers.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "@types/node": "^22.0.0"
  }
}
